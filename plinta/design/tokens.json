{
  "$description": "plinta design tokens — the single source of truth. Edit here, then run `python manage.py build_tokens` to regenerate static/plinta/css/tokens.css and static/plinta/js/tokens.js. Three tiers: `primitive` is the raw palette, emitted as --pl-p-*, and never used by a stylesheet directly; `static` tokens are the same in both themes; `semantic` tokens differ by theme and are what the stylesheet consumes. A value of {name} refers to a primitive; anything else is literal CSS. `rgb: true` also emits a <name>-rgb companion, for a translucent surface built with rgb().",

  "primitive": {
    "$description": "Raw palette. Theme-agnostic. Referenced by semantic tokens, never used directly.",
    "white":      { "$value": "#ffffff" },
    "black":      { "$value": "#000000" },
    "navy-700":   { "$value": "#1e3a5f" },
    "navy-950":   { "$value": "#1a2332" },
    "slate-50":   { "$value": "#f8fafc" },
    "slate-100":  { "$value": "#f1f5f9" },
    "slate-200":  { "$value": "#e2e8f0" },
    "slate-300":  { "$value": "#cbd5e1" },
    "slate-400":  { "$value": "#94a3b8" },
    "slate-500":  { "$value": "#64748b" },
    "slate-600":  { "$value": "#475569" },
    "slate-700":  { "$value": "#334155" },
    "slate-800":  { "$value": "#1e293b" },
    "slate-900":  { "$value": "#0f172a" },
    "slate-950":  { "$value": "#020617" },
    "blue-400":   { "$value": "#60a5fa" },
    "blue-500":   { "$value": "#3b82f6" },
    "green-500":  { "$value": "#22c55e" },
    "green-600":  { "$value": "#16a34a" },
    "amber-500":  { "$value": "#f59e0b" },
    "amber-600":  { "$value": "#d97706" },
    "red-500":    { "$value": "#ef4444" },
    "red-600":    { "$value": "#dc2626" },
    "sky-400":    { "$value": "#38bdf8" },
    "sky-600":    { "$value": "#0284c7" },
    "violet-500": { "$value": "#8b5cf6" },
    "cyan-500":   { "$value": "#06b6d4" },
    "pink-500":   { "$value": "#ec4899" },
    "teal-500":   { "$value": "#14b8a6" }
  },

  "static": {
    "$description": "Same in both themes. Emitted once in :root.",

    "--pl-font":          { "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" },
    "--pl-font-mono":     { "$value": "ui-monospace, SFMono-Regular, Menlo, monospace" },
    "--pl-font-xs":       { "$value": "0.6875rem" },
    "--pl-font-sm":       { "$value": "0.75rem" },
    "--pl-font-base":     { "$value": "0.875rem" },
    "--pl-font-md":       { "$value": "1rem" },
    "--pl-font-lg":       { "$value": "1.125rem" },
    "--pl-font-xl":       { "$value": "1.375rem" },
    "--pl-line-height":   { "$value": "1.5" },
    "--pl-weight-normal": { "$value": "400" },
    "--pl-weight-medium": { "$value": "500" },
    "--pl-weight-bold":   { "$value": "600" },

    "--pl-space-1": { "$value": "0.25rem" },
    "--pl-space-2": { "$value": "0.5rem" },
    "--pl-space-3": { "$value": "0.75rem" },
    "--pl-space-4": { "$value": "1rem" },
    "--pl-space-5": { "$value": "1.5rem" },
    "--pl-space-6": { "$value": "2rem" },
    "--pl-space-7": { "$value": "3rem" },

    "--pl-radius-sm": { "$value": "3px" },
    "--pl-radius":    { "$value": "6px" },
    "--pl-radius-lg": { "$value": "10px" },

    "--pl-transition": { "$value": "0.15s ease" },

    "--pl-topbar-height":  { "$value": "52px" },
    "--pl-sidebar-width":  { "$value": "248px" },
    "--pl-grid-columns":   { "$value": "12" },
    "--pl-grid-cell":      { "$value": "90px" },
    "--pl-grid-gap":       { "$value": "8px" },
    "--pl-content-max":    { "$value": "1600px" }
  },

  "semantic": {
    "$description": "Differ by theme. What the stylesheet consumes. A consumer retints by redefining these.",

    "--pl-bg":             { "light": "{slate-50}",  "dark": "{slate-950}" },
    "--pl-surface":        { "light": "{white}",     "dark": "{slate-900}", "rgb": true },
    "--pl-surface-raised": { "light": "{white}",     "dark": "{slate-800}" },
    "--pl-surface-sunken": { "light": "{slate-100}", "dark": "{slate-800}" },

    "--pl-fg":        { "light": "{slate-800}", "dark": "{slate-100}", "rgb": true },
    "--pl-fg-muted":  { "light": "{slate-500}", "dark": "{slate-400}" },
    "--pl-fg-subtle": { "light": "{slate-400}", "dark": "{slate-500}" },
    "--pl-fg-on-accent": { "light": "{white}",  "dark": "{slate-950}" },

    "--pl-border":        { "light": "{slate-200}", "dark": "{slate-700}" },
    "--pl-border-strong": { "light": "{slate-300}", "dark": "{slate-600}" },

    "--pl-accent":        { "light": "{navy-700}", "dark": "{blue-400}", "rgb": true },
    "--pl-accent-hover":  { "light": "color-mix(in srgb, var(--pl-accent) 85%, black)",
                            "dark":  "color-mix(in srgb, var(--pl-accent) 85%, white)" },
    "--pl-accent-active": { "light": "color-mix(in srgb, var(--pl-accent) 75%, black)",
                            "dark":  "color-mix(in srgb, var(--pl-accent) 75%, white)" },
    "--pl-accent-subtle": { "light": "color-mix(in srgb, var(--pl-accent) 8%, transparent)",
                            "dark":  "color-mix(in srgb, var(--pl-accent) 18%, transparent)" },

    "--pl-success": { "light": "{green-600}", "dark": "{green-500}", "rgb": true },
    "--pl-danger":  { "light": "{red-600}",   "dark": "{red-500}",   "rgb": true },
    "--pl-warning": { "light": "{amber-600}", "dark": "{amber-500}", "rgb": true },
    "--pl-info":    { "light": "{sky-600}",   "dark": "{sky-400}",   "rgb": true },

    "--pl-hover-bg":  { "light": "color-mix(in srgb, var(--pl-fg) 5%, transparent)",
                        "dark":  "color-mix(in srgb, var(--pl-fg) 8%, transparent)" },
    "--pl-active-bg": { "light": "color-mix(in srgb, var(--pl-accent) 10%, transparent)",
                        "dark":  "color-mix(in srgb, var(--pl-accent) 22%, transparent)" },
    "--pl-focus-ring": { "light": "color-mix(in srgb, var(--pl-accent) 35%, transparent)",
                         "dark":  "color-mix(in srgb, var(--pl-accent) 45%, transparent)" },

    "--pl-backdrop": { "light": "rgb(15 23 42 / 0.4)", "dark": "rgb(0 0 0 / 0.6)" },

    "--pl-shadow-sm": { "light": "0 1px 2px rgb(15 23 42 / 0.06)",
                        "dark":  "0 1px 2px rgb(0 0 0 / 0.4)" },
    "--pl-shadow":    { "light": "0 2px 6px rgb(15 23 42 / 0.08)",
                        "dark":  "0 2px 6px rgb(0 0 0 / 0.5)" },
    "--pl-shadow-lg": { "light": "0 8px 24px rgb(15 23 42 / 0.12)",
                        "dark":  "0 8px 24px rgb(0 0 0 / 0.6)" },

    "--pl-chart-1": { "light": "{navy-700}",   "dark": "{blue-400}" },
    "--pl-chart-2": { "light": "{teal-500}",   "dark": "{teal-500}" },
    "--pl-chart-3": { "light": "{amber-600}",  "dark": "{amber-500}" },
    "--pl-chart-4": { "light": "{violet-500}", "dark": "{violet-500}" },
    "--pl-chart-5": { "light": "{red-600}",    "dark": "{red-500}" },
    "--pl-chart-6": { "light": "{cyan-500}",   "dark": "{cyan-500}" },
    "--pl-chart-7": { "light": "{pink-500}",   "dark": "{pink-500}" },
    "--pl-chart-8": { "light": "{green-600}",  "dark": "{green-500}" }
  },

  "chart_palette": [
    "--pl-chart-1", "--pl-chart-2", "--pl-chart-3", "--pl-chart-4",
    "--pl-chart-5", "--pl-chart-6", "--pl-chart-7", "--pl-chart-8"
  ]
}
